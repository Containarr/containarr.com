{
  "category": "Internet",
  "version": 1,
  "name": "Pi-hole",
  "port": 80,
  "description": "Pi-hole is a network-wide ad blocker that acts as a DNS sinkhole.",
  "website": "https://pi-hole.net",
  "dockerImage": "docker.io/pihole/pihole:latest",
  "dockerPorts": [
    "53:53/tcp",
    "53:53/udp"
  ],
  "dockerNetworkMode": "bridge",
  "dockerVolumes": {},
  "dockerEnvironment": {
    "TZ": "$TIMEZONE"
  }
}